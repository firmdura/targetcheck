diff --git a/src/http.c b/src/http.c
--- a/src/http.c
+++ b/src/http.c
@@ -957,6 +957,12 @@ parse_content_range (const char *hdr, wgint *first_byte_ptr,
     return false;
   if (*last_byte_ptr < *first_byte_ptr)
     return false;
+  /* Local TargetCheck guard, pending upstream review: the caller computes
+     last_byte_pos - first_byte_pos + 1.  Both positions are nonnegative
+     and last >= first here, so that length overflows wgint only for a
+     zero first position and a WGINT_MAX last position.  */
+  if (*first_byte_ptr == 0 && *last_byte_ptr == WGINT_MAX)
+    return false;
   if (*hdr == '*')
     num = -1;
   else
