        {
          "argv": [
            "make",
            "-C",
            "tests",
            "unit-tests"
          ],
          "env": {
            "LC_ALL": "C"
          },
          "timeout_seconds": 1800
        }
      ],
      "inputs": [
        "TARGETCHECK-VARIANT.txt",
        "TARGETCHECK-SOURCE.sha256",
        "configure",
        "src/http.c",
        "tests/content-range-cases.c",
        "tests/unit-tests.c",
        "tests/unit-tests.h"
      ],
      "artifacts": [
        "tests/unit-tests"
      ]
    }
  },
  "test_inputs": [],
  "tests": [
    {
      "id": "oversized-first-byte-pos",
      "argv": [
        "tests/unit-tests",
        "oversized-first-byte-pos"
      ],
      "timeout_seconds": 120,
      "baseline_expect": {
        "exit_code": 1,
        "stdout_contains": "RUNNING TEST oversized-first-byte-pos...",
        "stderr_contains": "http.c:936:9: runtime error: signed integer overflow: 9223372036854775800 + 8 cannot be represented in type 'long int'"
      },
      "candidate_expect": {
        "exit_code": 0,
        "stdout_contains": "PASSED oversized-first-byte-pos"
      }
    },
    {
      "id": "oversized-last-byte-pos",
      "argv": [
        "tests/unit-tests",
        "oversized-last-byte-pos"
      ],
      "timeout_seconds": 120,
      "baseline_expect": {
        "exit_code": 1,
        "stdout_contains": "RUNNING TEST oversized-last-byte-pos...",
        "stderr_contains": "http.c:942:9: runtime error: signed integer overflow: 9223372036854775800 + 8 cannot be represented in type 'long int'"
