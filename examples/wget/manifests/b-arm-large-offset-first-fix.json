{
  "schema_version": 1,
  "target": {
    "kind": "qemu-arm",
    "executable": "qemu-arm",
    "sysroot": "/usr/arm-linux-gnueabihf"
  },
  "variants": {
    "baseline": {
      "cwd": "b-arm-large-offset-first-fix/unpatched",
      "build": [
        {
          "argv": [
            "./configure",
            "--host=arm-linux-gnueabihf",
            "--disable-nls",
            "--disable-iri",
            "--without-ssl",
            "--without-zlib",
            "--without-libpsl",
            "--without-metalink",
            "--without-libuuid",
            "--disable-pcre",
            "--disable-pcre2",
            "--disable-xattr",
            "--disable-ntlm",
            "--disable-opie",
            "--disable-digest",
            "--disable-threads",
            "--disable-rpath",
            "--without-cares",
            "--disable-dependency-tracking",
            "CC=arm-linux-gnueabihf-gcc",
            "CFLAGS=-O1 -fsanitize=undefined -fno-sanitize-recover=undefined",
            "CPPFLAGS=",
            "LDFLAGS=-fsanitize=undefined",
            "LIBS="
          ],
          "env": {
            "CONFIG_SITE": "/dev/null",
            "LC_ALL": "C"
          },
          "timeout_seconds": 1800
        },
        {
          "argv": [
            "make",
            "-C",
            "lib"
          ],
          "env": {
            "LC_ALL": "C"
          },
          "timeout_seconds": 1800
        },
        {
          "argv": [
            "make",
            "-C",
            "src",
            "libunittest.a"
          ],
          "env": {
            "LC_ALL": "C"
          },
          "timeout_seconds": 1800
        },
        {
          "argv": [
            "make",
            "-C",
            "tests",
            "unit-tests"
          ],
          "env": {
            "LC_ALL": "C"
          },
          "timeout_seconds": 1800
        }
      ],
      "inputs": [
        "TARGETCHECK-VARIANT.txt",
        "TARGETCHECK-SOURCE.sha256",
        "configure",
        "src/http.c",
        "tests/content-range-cases.c",
        "tests/unit-tests.c",
        "tests/unit-tests.h"
      ],
      "artifacts": [
        "tests/unit-tests"
      ]
    },
    "candidate": {
      "cwd": "b-arm-large-offset-first-fix/first-fix",
      "build": [
        {
          "argv": [
            "./configure",
            "--host=arm-linux-gnueabihf",
            "--disable-nls",
            "--disable-iri",
            "--without-ssl",
            "--without-zlib",
            "--without-libpsl",
            "--without-metalink",
            "--without-libuuid",
            "--disable-pcre",
            "--disable-pcre2",
            "--disable-xattr",
            "--disable-ntlm",
            "--disable-opie",
            "--disable-digest",
            "--disable-threads",
            "--disable-rpath",
            "--without-cares",
            "--disable-dependency-tracking",
            "CC=arm-linux-gnueabihf-gcc",
            "CFLAGS=-O1 -fsanitize=undefined -fno-sanitize-recover=undefined",
            "CPPFLAGS=",
            "LDFLAGS=-fsanitize=undefined",
            "LIBS="
          ],
          "env": {
            "CONFIG_SITE": "/dev/null",
            "LC_ALL": "C"
          },
          "timeout_seconds": 1800
        },
        {
          "argv": [
            "make",
            "-C",
            "lib"
          ],
          "env": {
            "LC_ALL": "C"
          },
          "timeout_seconds": 1800
        },
        {
          "argv": [
            "make",
            "-C",
            "src",
            "libunittest.a"
          ],
          "env": {
            "LC_ALL": "C"
          },
          "timeout_seconds": 1800
        },
        {
          "argv": [
            "make",
            "-C",
            "tests",
            "unit-tests"
          ],
          "env": {
            "LC_ALL": "C"
          },
          "timeout_seconds": 1800
        }
      ],
      "inputs": [
        "TARGETCHECK-VARIANT.txt",
        "TARGETCHECK-SOURCE.sha256",
        "configure",
        "src/http.c",
        "tests/content-range-cases.c",
        "tests/unit-tests.c",
        "tests/unit-tests.h"
      ],
      "artifacts": [
        "tests/unit-tests"
      ]
    }
  },
  "test_inputs": [],
  "tests": [
    {
      "id": "large-offset-first-byte-pos",
      "argv": [
        "tests/unit-tests",
        "large-offset-first-byte-pos"
      ],
      "timeout_seconds": 120,
      "baseline_expect": {
        "exit_code": 0,
        "stdout_contains": "PASSED large-offset-first-byte-pos"
      },
      "candidate_expect": {
        "exit_code": 0,
        "stdout_contains": "PASSED large-offset-first-byte-pos"
      }
    },
    {
