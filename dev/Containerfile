# SPDX-License-Identifier: Apache-2.0
# Build with Dockerfile stdin and NO context: make container-build.
FROM golang:1.27.4-bookworm@sha256:4fa7c968ba93f1635670522dbb01a2c78150443e1385746924566079f36570ea

RUN set -eux; \
    case "$(dpkg --print-architecture)" in amd64|arm64) ;; *) exit 1 ;; esac; \
    printf '%s\n' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261104T212339Z bookworm main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20261104T212339Z bookworm-updates main' \
      'deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20261104T212339Z bookworm-security main' \
      > /etc/apt/sources.list; \
    rm /etc/apt/sources.list.d/debian.sources; \
    apt-get -o Acquire::Check-Valid-Until=false update; \
    apt-get install -y --no-install-recommends \
      gcc-arm-linux-gnueabihf=4:12.2.0-3 \
      gcc-12-arm-linux-gnueabihf=12.2.0-14cross1 \
      binutils-arm-linux-gnueabihf=2.40-2 \
      libc6-dev-armhf-cross=2.36-8cross1 \
      qemu-user=1:7.2+dfsg-7+deb12u18+b3 \
      file=1:5.44-3 patch=2.7.6-7 \
      autoconf=2.71-3 automake=1:1.16.5-1.3; \
    rm -rf /var/lib/apt/lists/*; \
    test "$(go version | cut -d ' ' -f 3)" = go1.27.4; \
    { go version; gcc --version | head -1; arm-linux-gnueabihf-gcc --version | head -1; \
      qemu-arm --version | head -1; \
      dpkg-query -W gcc gcc-12 gcc-arm-linux-gnueabihf gcc-12-arm-linux-gnueabihf \
        binutils-arm-linux-gnueabihf libc6-dev-armhf-cross qemu-user file patch autoconf automake; \
    } > /opt/targetcheck-tool-versions.txt

ENV GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off CGO_ENABLED=1
WORKDIR /src
